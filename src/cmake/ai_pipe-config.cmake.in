# ==================================================================================
# Config file for the ai_pipe package.
#
# Defines the imported target ai_pipe::ai_pipe.
#
# This template must be expanded with configure_package_config_file(), which
# substitutes @PACKAGE_INIT@ below with the standard prologue (set_and_check,
# check_required_components, relocatable PACKAGE_PREFIX_DIR).
# ==================================================================================

@PACKAGE_INIT@

# --- Include the targets file ---
# This file contains the definition for the IMPORTED target 'ai_pipe::ai_pipe'.
# It is generated by the install(EXPORT) command.
if(NOT TARGET ai_pipe::ai_pipe)
  include("${CMAKE_CURRENT_LIST_DIR}/ai_pipe-targets.cmake")
endif()

check_required_components(ai_pipe)
