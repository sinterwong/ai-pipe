{
  "cmake.installPrefix": "${workspaceFolder}/build",
  "cmake.configureSettings": {
    "CMAKE_BUILD_TYPE": "${buildType}",
    "CMAKE_INSTALL_PREFIX": "${workspaceFolder}/install",
  },
  // "cmake.generator": "Unix Makefiles",
  "cmake.generator": "Ninja",
  "cmake.exportCompileCommandsFile": true,
  "cmake.environment": {
    //   "PATH": "${env:PATH}",
    "LD_LIBRARY_PATH": "${workspaceFolder}/3rdparty/target/Linux_x86_64/dependency_lib:${env:LD_LIBRARY_PATH}",
    // "ANDROID_NDK": "/home/sinter/softwares/android-ndk-r27c"
  },
  "cmake.configureArgs": [
    // "-DCMAKE_TOOLCHAIN_FILE=/home/sinter/softwares/android-ndk-r27c/build/cmake/android.toolchain.cmake",
    // "-DANDROID_ABI=arm64-v8a",
    // "-DANDROID_PLATFORM=android-24",
    // "-DANDROID_STL=c++_shared",
    "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
    "-DBUILD_AI_SDK_TESTS=ON",
  ],
  "cmake.options.statusBarVisibility": "compact",
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "git.terminalAuthentication": true,
  "cmake.configureOnOpen": true,
  "C_Cpp.autocompleteAddParentheses": true,
  "C_Cpp.clang_format_path": "/home/wangxt/workspace/sk_breast/sk_breast/.vscode/.clang-format",
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.autocomplete": "default",
  "C_Cpp.autoAddFileAssociations": true,
  "C_Cpp.codeAnalysis.runAutomatically": true,
  "C_Cpp.default.intelliSenseMode": "linux-gcc-arm64",
  "C_Cpp.errorSquiggles": "disabled",
  "cmake.cmakePath": "cmake",
  "files.associations": {
    "alignedvector3": "cpp",
    "span": "cpp",
    "string_span": "cpp",
    "*.inc": "cpp",
    "array": "cpp",
    "string": "cpp",
    "string_view": "cpp",
    "ranges": "cpp"
  }
}