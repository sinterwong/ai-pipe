---
# -------------------------------------------------------------------------
# Checks (F2: 必过门禁,CI 移除 continue-on-error 后由退出码把关)
#
# 选入: bugprone / concurrency / performance / portability 全组 +
#       命名检查。整个 src/ 树(含头文件)当前对该集合零告警。
#
# 逐项排除(误报/低价值类,非未修净):
# - bugprone-easily-swappable-parameters: 纯噪声,业界普遍排除。
# - bugprone-unchecked-optional-access: 需要全程序不变量推理
#   (如引擎初始化后 m_compiledGraph 必然有值),全部命中均为误报。
# - performance-enum-size: 建议缩小枚举底层类型,会破坏公共 API 且
#   无实测收益。
#
# 个别站点的有意偏离用行内 NOLINT + 理由注释标注(而非全局排除)。
# -------------------------------------------------------------------------
Checks: '-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-unchecked-optional-access,
  concurrency-*,
  performance-*,
  -performance-enum-size,
  portability-*,
  readability-identifier-naming'

# 任何命中即失败 (门禁语义)
WarningsAsErrors: '*'

# 覆盖本项目 src/ 下的头文件;3rdparty 与构建产物不在 src/ 下,天然排除
HeaderFilterRegex: '.*/src/.*'

CheckOptions:
  # =========================================================================
  # 类型定义 (PascalCase)
  #    例如: class AlgoInferEngine, struct TensorData, enum DataType
  # =========================================================================
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.StructCase
    value:           CamelCase
  - key:             readability-identifier-naming.EnumCase
    value:           CamelCase
  - key:             readability-identifier-naming.UnionCase
    value:           CamelCase
  - key:             readability-identifier-naming.TypedefCase
    value:           CamelCase

  # =========================================================================
  # 函数与方法 (camelBack)
  #    例如: initialize(), getModelInfo()
  # =========================================================================
  - key:             readability-identifier-naming.FunctionCase
    value:           camelBack
  - key:             readability-identifier-naming.MethodCase
    value:           camelBack
  # 虚函数重写通常需要保持父类风格，这里强制检查，如果报错需要手动 suppress
  
  # =========================================================================
  # 变量与参数 (lower_case)
  #    例如: int device_id, float input_score
  # =========================================================================
  # 通用变量设置 (作为兜底)
  - key:             readability-identifier-naming.VariableCase
    value:           lower_case
  # 局部变量
  - key:             readability-identifier-naming.LocalVariableCase
    value:           lower_case
  # 函数参数
  - key:             readability-identifier-naming.ParameterCase
    value:           lower_case
  # 全局变量
  - key:             readability-identifier-naming.GlobalVariableCase
    value:           lower_case

  # =========================================================================
  # 成员变量
  # =========================================================================
  
  # A. 公有成员 (Public Members) -> lower_case
  #    场景: struct BoundingBox { int x; int y; };
  - key:             readability-identifier-naming.PublicMemberCase
    value:           lower_case

  # B. 私有成员 (Private Members) -> m_ + camelBack
  #    场景: class Engine { int m_deviceId; };
  #    注意: 必须同时设置 Prefix 和 Case，且不要设置通用的 MemberCase
  - key:             readability-identifier-naming.PrivateMemberPrefix
    value:           m_
  - key:             readability-identifier-naming.PrivateMemberCase
    value:           camelBack

  # C. 保护成员 (Protected Members) -> m_ + camelBack
  - key:             readability-identifier-naming.ProtectedMemberPrefix
    value:           m_
  - key:             readability-identifier-naming.ProtectedMemberCase
    value:           camelBack

  # =========================================================================
  # 其他
  # =========================================================================
  # 命名空间 -> 蛇形 (ai_core)
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case
  
  # 宏定义 -> 全大写 (AI_CORE_VERSION)
  - key:             readability-identifier-naming.MacroDefinitionCase
    value:           UPPER_CASE
  
  # 枚举值 -> 大驼峰 (DataType::Float32) 或 全大写
  # 推荐使用 CamelCase 以区分宏，与类名风格一致
  - key:             readability-identifier-naming.EnumConstantCase
    value:           CamelCase
    
  # 模板参数 -> 大驼峰 (template <typename T> 或 typename InputType)
  - key:             readability-identifier-naming.TemplateParameterCase
    value:           CamelCase

...
